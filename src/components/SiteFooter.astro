---
import { siteConfig } from '@/config/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>© {year} {siteConfig.author.name}</span>
    <div class="site-footer__meta">
      {siteConfig.social.map((item) => (
        <a href={item.href} aria-label={item.label} title={item.label} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          <Icon name={item.icon} size={15} />
        </a>
      ))}
    </div>
  </div>
</footer>
