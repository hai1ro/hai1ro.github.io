---
import type { IconName } from './icons';
import { icons } from './icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const inner = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={inner}
/>
