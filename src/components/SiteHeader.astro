---
import { siteConfig } from '@/config/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/' || path === '';
  const base = href.replace(/\/$/, '');
  return path === base || path === `${base}/` || path.startsWith(`${base}/`);
};
---

<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${siteConfig.title} 首页`}>
      <span class="brand__mark" aria-hidden="true">H</span>
      <span class="brand__text">{siteConfig.title}</span>
    </a>

    <nav class="site-nav" id="site-nav" data-site-nav aria-label="主导航">
      {
        siteConfig.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-actions">
      <a
        class="icon-btn"
        href={siteConfig.adminPath}
        aria-label="管理后台"
        title="管理后台"
      >
        <Icon name="pencil" size={17} />
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深色模式">
        <span class="theme-icon theme-icon--light"><Icon name="moon" size={17} /></span>
        <span class="theme-icon theme-icon--dark"><Icon name="sun" size={17} /></span>
      </button>
      <button
        class="icon-btn mobile-only"
        type="button"
        data-menu-toggle
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="menu-icon--open"><Icon name="menu" size={19} /></span>
        <span class="menu-icon--close"><Icon name="close" size={19} /></span>
      </button>
    </div>
  </div>
</header>
