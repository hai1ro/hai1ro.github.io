---
import Icon from './Icon.astro';
import '@/styles/search.css';
---

<div class="search-overlay" data-search-dialog hidden>
  <button
    type="button"
    class="search-overlay__backdrop"
    data-search-close
    aria-label="关闭搜索"
    tabindex="-1"
  ></button>

  <div
    class="search-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-title"
    data-search-panel
  >
    <h2 class="sr-only" id="search-title">搜索内容</h2>

    <div class="search-panel__head">
      <span class="search-panel__icon"><Icon name="search" size={19} /></span>
      <input
        class="search-panel__input"
        type="search"
        data-search-input
        placeholder="搜索文章、日记、照片或标签…"
        aria-label="搜索内容"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="search-panel__close" data-search-close aria-label="关闭搜索">
        <Icon name="close" size={16} />
      </button>
    </div>

    <div class="search-panel__status" data-search-status aria-live="polite">
      输入关键词开始搜索
    </div>

    <div class="search-results" data-search-results role="listbox" aria-label="搜索结果"></div>

    <div class="search-empty" data-search-empty hidden>
      <span class="search-empty__mark">∅</span>
      <p>没有找到匹配的内容</p>
      <span>换一个关键词，或者试试标签。</span>
    </div>

    <footer class="search-panel__foot">
      <div class="search-panel__keys">
        <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
        <span><kbd>↵</kbd> 打开</span>
        <span><kbd>esc</kbd> 关闭</span>
      </div>
      <button type="button" class="search-random" data-search-random>
        <Icon name="shuffle" size={14} />
        随便看看
      </button>
    </footer>
  </div>
</div>

<script>
  import '@/scripts/search';
</script>
