---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import {
  collectTags,
  contentTypeLabel,
  getAllPosts,
  postExcerpt,
  postHref,
  postTitle,
  readingMinutes,
} from '@/lib/posts';
import { toISODate } from '@/lib/date';

const posts = await getAllPosts();
const tags = collectTags(posts);
const typeCounts = {
  article: posts.filter((post) => post.data.type === 'article').length,
  diary: posts.filter((post) => post.data.type === 'diary').length,
  photo: posts.filter((post) => post.data.type === 'photo').length,
};

const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const year = String(post.data.date.getFullYear());
  const list = groups.get(year) ?? [];
  list.push(post);
  groups.set(year, list);
}
---

<BaseLayout title="内容" description="按时间整理的所有文章、日记和照片，可按类型、标签筛选或搜索。">
  <div data-archive>
    <section class="archive-hero">
      <div class="container">
        <p class="eyebrow">Archive</p>
        <h1>所有内容</h1>
        <p>
          共 {posts.length} 条内容，包括文章、日记和照片。按时间排列，也可以按类型、标签筛选或直接搜索。
        </p>
      </div>
    </section>

    <div class="archive-toolbar">
      <div class="container">
        <label class="archive-search">
          <span class="archive-search__icon"><Icon name="search" size={16} /></span>
          <input
            type="search"
            data-archive-search
            placeholder="搜索标题、摘要或标签…"
            aria-label="搜索内容"
            autocomplete="off"
          />
        </label>

        <div class="archive-tags" role="group" aria-label="按类型筛选">
          <button
            type="button"
            class="chip"
            data-archive-type=""
            data-active="true"
            aria-pressed="true"
          >
            全部
            <em>{posts.length}</em>
          </button>
          {(['article', 'diary', 'photo'] as const).map((type) => (
            <button
              type="button"
              class="chip"
              data-archive-type={type}
              data-active="false"
              aria-pressed="false"
            >
              {contentTypeLabel(type)}
              <em>{typeCounts[type]}</em>
            </button>
          ))}
        </div>

        <div class="archive-tags" role="group" aria-label="按标签筛选">
          {tags.map((tag) => (
            <button
              type="button"
              class="chip"
              data-archive-tag={tag.name}
              data-active="false"
              aria-pressed="false"
            >
              {tag.name}
              <em>{tag.count}</em>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="container">
      <div class="archive-summary">
        <span data-archive-count aria-live="polite">{posts.length} 条</span>
        <span data-archive-filtered hidden>已应用筛选</span>
      </div>

      {[...groups.entries()].map(([year, list]) => (
        <section class="archive-group" data-archive-group aria-label={`${year} 年`}>
          <div class="archive-year">{year}</div>
          <div>
            {list.map((post) => {
              const title = postTitle(post);
              const excerpt = postExcerpt(post, 100);
              const typeLabel = contentTypeLabel(post.data.type);
              const searchText = [
                title,
                excerpt,
                post.data.tags.join(' '),
                post.id,
                typeLabel,
              ]
                .join(' ')
                .toLowerCase();
              return (
                <a
                  class="archive-item"
                  href={postHref(post)}
                  data-archive-item
                  data-type={post.data.type}
                  data-search={searchText}
                  data-tags={JSON.stringify(post.data.tags)}
                >
                  <time class="archive-item__date" datetime={toISODate(post.data.date)}>
                    {toISODate(post.data.date).slice(5, 10).replace('-', '.')}
                  </time>
                  <div>
                    <h3>
                      <span class="type-badge" data-type={post.data.type}>{typeLabel}</span>
                      {title}
                      {post.data.draft && <span class="draft-badge">草稿</span>}
                    </h3>
                    {excerpt && <p class="archive-item__desc">{excerpt}</p>}
                  </div>
                  <div class="archive-item__tags">
                    {post.data.type === 'photo' ? (
                      <span class="archive-item__reading">{post.data.images.length} 张</span>
                    ) : (
                      <span class="archive-item__reading">{readingMinutes(post)} 分钟</span>
                    )}
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <div class="archive-empty" data-archive-empty hidden>
        <p class="serif">没有找到内容</p>
        <span>换个关键词、类型或标签试试。</span>
        <button type="button" data-archive-reset>清除筛选</button>
      </div>
    </div>
  </div>

  <script>
    import '@/scripts/archive';
  </script>
</BaseLayout>
