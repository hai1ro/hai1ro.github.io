---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getAllPosts, postExcerpt, postTitle, readingMinutes } from '@/lib/posts';
import { formatDateShort, relativeTime, toISODate } from '@/lib/date';
import { parseProfileSource } from '@/lib/profile';
import profileSource from '@/content/profile.md?raw';
import '@/styles/home.css';
import { HomePage, type HomeItem } from '@/components/home/HomePage';

const profile = parseProfileSource(profileSource).data;
const posts = await getAllPosts();

const items: HomeItem[] = posts.map((post) => ({
  slug: post.id,
  type: post.data.type,
  title: postTitle(post),
  excerpt: postExcerpt(post),
  body: (post.body ?? '').trim(),
  dateLabel: formatDateShort(post.data.date),
  dateISO: toISODate(post.data.date),
  relativeLabel: relativeTime(post.data.date),
  tags: post.data.tags,
  cover: post.data.cover,
  images: post.data.images,
  minutes: readingMinutes(post),
  draft: post.data.draft,
}));

const githubUrl =
  profile.infos.find((info) => info.href && /github/i.test(info.href))?.href ??
  `https://github.com/${profile.handle || siteConfig.author.github}`;
---

<BaseLayout description={profile.signature || siteConfig.description}>
  <HomePage
    client:load
    profile={{
      name: profile.name,
      handle: profile.handle,
      avatar: profile.avatar,
      signature: profile.signature,
      infos: profile.infos,
    }}
    items={items}
    githubUrl={githubUrl}
    rssUrl="/rss.xml"
  />
</BaseLayout>
